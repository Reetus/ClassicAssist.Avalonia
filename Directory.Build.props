<Project>

  <PropertyGroup>
    <!--
      NETSDK1206: LibDeflate.Native ships its macOS binary under the version-specific RID
      "osx.11.0", which the portable RID graph never matches from osx-arm64 or osx-x64. The file is
      still copied to the output, and ClassicAssist.Shared/UO/Compression.cs resolves it from there
      via a DllImportResolver, so this is handled rather than ignored. The warning surfaces in every
      project that transitively references the package, hence suppressing it here.
    -->
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>

    <!--
      IDE* rules ship in the SDK but do not run during build by default - they only surface in the
      IDE and in `dotnet format`. .editorconfig sets their severity; this makes the build actually
      run them, so CI enforces the same rules the IDE shows.
    -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
