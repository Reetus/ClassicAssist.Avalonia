<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net10.0 matches the runtime modern TazUO ships. net472 is the build the legacy Mono-based
      TazUO loads; it rejects a modern assembly outright with "Could not load file or assembly
      'System.Runtime, Version=9.0.0.0'". The UI is unaffected either way - the plugin only ever
      launches it as a separate child process, so it stays a normal .NET app.
    -->
    <TargetFrameworks>net10.0;net472</TargetFrameworks>
    <!-- net472 defaults to C# 7.3, which has no function pointers. -->
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- ClassicUO/TazUO look for the type Assistant.Engine inside a file named ClassicAssist.dll -->
    <AssemblyName>ClassicAssist</AssemblyName>
    <RootNamespace>ClassicAssist.Plugin</RootNamespace>
    <OutputPath>..\Output\ClassicAssist\</OutputPath>
    <!-- Its own folder: the two builds have different dependency closures and cannot share one. -->
    <OutputPath Condition="'$(TargetFramework)' == 'net472'">..\Output\ClassicAssist\framework\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!--
      AppendTargetFrameworkToOutputPath=false strips the framework from the intermediate path too, so
      both inner builds would compile to the same obj\Debug\ClassicAssist.dll and each would then copy
      whichever one was written last. Keep the final output flat, but give the intermediates a
      per-framework home. Guarded because the outer multi-targeting build has no TargetFramework.
    -->
    <IntermediateOutputPath Condition="'$(TargetFramework)' != ''">obj\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!--
    DNNE emits a native shim exporting `Install`, which modern ClassicUO needs because it only
    dlopen()s the plugin and never falls back to a managed load. TazUO does fall back, and on Linux
    it always takes that path (there is no standalone libdl.so on modern distros, so its dlopen
    throws immediately), so the managed Assistant.Engine.Install entry point is sufficient there.

    Building the shim needs clang, so it turns itself on only when clang is actually there - that
    way one plain `dotnet build` produces every artifact the machine can produce, and a machine
    without a C toolchain still builds rather than failing. Force either way with -p:EnableDnne=.

    The shim is meaningless for net472: that build exists for a Mono host which always takes the
    managed path.
  -->
  <PropertyGroup Condition="'$(EnableDnne)' == ''">
    <EnableDnne Condition="Exists('/usr/bin/clang') Or Exists('/usr/local/bin/clang')">true</EnableDnne>
    <EnableDnne Condition="'$(EnableDnne)' == ''">false</EnableDnne>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
    <EnableDnne>false</EnableDnne>
  </PropertyGroup>

  <Target Name="WarnDnneSkipped" BeforeTargets="Build"
          Condition="'$(EnableDnne)' != 'true' And '$(TargetFramework)' != 'net472'">
    <Message Importance="high"
             Text="ClassicAssist: clang not found, skipping the DNNE native shim. The managed entry point still works for TazUO; modern ClassicUO needs the shim." />
  </Target>

  <PropertyGroup Condition="'$(EnableDnne)' == 'true'">
    <!--
      The shim starts the runtime through hostfxr, which needs a runtimeconfig.json beside the
      managed assembly. Class libraries do not emit one, so dlsym would find `Install` and the call
      would then fail to activate the runtime. RollForward lets it run on a newer shared runtime
      than the net10.0 it targets.
    -->
    <DnneGenRollForward>LatestMajor</DnneGenRollForward>
  </PropertyGroup>

  <!--
    GenerateRuntimeConfigurationFiles only emits runtimeconfig.json for OutputType=Exe.
    DNNE needs it next to the managed assembly to activate the runtime, so write it manually.
  -->
  <Target Name="GenerateRuntimeConfig" AfterTargets="Build" Condition="'$(EnableDnne)' == 'true'">
    <WriteLinesToFile
      File="$(OutputPath)\ClassicAssist.runtimeconfig.json"
      Lines="{
  &quot;runtimeOptions&quot;: {
    &quot;tfm&quot;: &quot;net10.0&quot;,
    &quot;framework&quot;: {
      &quot;name&quot;: &quot;Microsoft.NETCore.App&quot;,
      &quot;version&quot;: &quot;10.0.0&quot;
    },
    &quot;rollForward&quot;: &quot;LatestMajor&quot;
  }
}"
      Overwrite="true" />
  </Target>

  <ItemGroup Condition="'$(EnableDnne)' == 'true'">
    <PackageReference Include="DNNE" Version="1.0.33" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" Version="2.22.23" />
  </ItemGroup>

  <!--
    The CUO_API contract must come from this exact assembly identity (cuoapi, 1.3.0.0) rather than being
    redeclared locally. The client hands us its own delegates as function pointers, and
    Marshal.GetDelegateForFunctionPointer refuses to return a delegate as a same-named type from a
    different assembly - redeclaring compiles fine but throws InvalidCastException inside Install.
    Private=false for managed loads: the host runtime (ClassicUO/bootstrap) already has cuoapi loaded;
    shipping our copy would cause type-identity mismatches.
    Private=true for DNNE: the plugin gets its own .NET runtime via hostfxr so cuoapi must be deployed.
  -->
  <ItemGroup>
    <Reference Include="cuoapi" Condition="'$(EnableDnne)' != 'true'">
      <HintPath>.\cuoapi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="cuoapi" Condition="'$(EnableDnne)' == 'true'">
      <HintPath>.\cuoapi.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!--
    StreamJsonRpc and its dependencies ship only netstandard2.0 assets for Framework, so they - and
    therefore we - reference the netstandard 2.0 facade. The Mono BCL that legacy TazUO bundles does
    not include it: every dependency the game itself ships is a net46x flavour that binds straight to
    mscorlib, so it never needed one. Without this the plugin loads, reaches Install, and dies with
    "Could not load file or assembly 'netstandard, Version=2.0.0.0'".

    Taken from the reference path the SDK already resolved rather than a hardcoded package path.
    Assistant.Engine's AssemblyResolve handler probes the plugin directory, so dropping it beside the
    assembly is enough.

    Caveat: this facade carries [ReferenceAssembly]. It is pure type-forwards with no method bodies,
    and Mono does not enforce that attribute the way .NET Framework does, but if a runtime ever
    refuses it the fix is a real facade from a Mono or .NET Framework install.
  -->
  <Target Name="CopyNetStandardFacade" AfterTargets="Build" Condition="'$(TargetFramework)' == 'net472'">
    <ItemGroup>
      <NetStandardFacade Include="@(ReferencePath)" Condition="'%(FileName)' == 'netstandard'" />
    </ItemGroup>
    <Error Condition="'@(NetStandardFacade)' == ''"
           Text="Could not locate the netstandard facade in the reference path; the net472 plugin will not load without it." />
    <Copy SourceFiles="@(NetStandardFacade)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\ClassicAssist.Plugin.Shared\ClassicAssist.Plugin.Shared.csproj" />
  </ItemGroup>

    <PropertyGroup>
        <BuildDate>$([System.DateTime]::op_Subtraction($([System.DateTime]::get_Now().get_Date()),$([System.DateTime]::new(2020,7,3))).get_TotalDays())</BuildDate>
        <Version>0.3.$(BuildDate).0</Version>
    </PropertyGroup>
</Project>
