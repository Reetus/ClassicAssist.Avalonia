<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RollForward>LatestMajor</RollForward>
        <Nullable>disable</Nullable>
        <AssemblyTitle>PacketTransportBenchmark</AssemblyTitle>
        <Product>PacketTransportBenchmark</Product>
        <!-- Diagnostic tool, not shipped - kept out of Output\ClassicAssist so it never ends up in
             the release zip (see release.yml's "Verify package layout" step). -->
        <OutputPath>..\..\Output\Tools\PacketTransportBenchmark\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>
    <ItemGroup>
        <!-- The real plugin-side contracts, so the benchmark cannot drift from the product's shapes. -->
        <ProjectReference Include="..\..\ClassicAssist.Plugin.Shared\ClassicAssist.Plugin.Shared.csproj" />
        <PackageReference Include="StreamJsonRpc" Version="2.22.23" />
        <PackageReference Include="MessagePack" Version="2.5.302" />
        <!-- Kept on the one version every project uses; StreamJsonRpc would otherwise resolve 13.0.3. -->
        <PackageReference Include="Newtonsoft.Json" Version="$(NewtonsoftJsonVersion)" />
    </ItemGroup>
</Project>
