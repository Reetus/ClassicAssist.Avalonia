<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <!-- Matches the runtime TazUO ships; roll forward onto anything newer the user has. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="packetlengths.json" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="packetlengths.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ClassicAssist.Shared\ClassicAssist.Shared.csproj" />
    <ProjectReference Include="..\ClassicAssist.Launcher\ClassicAssist.Launcher.csproj" />
  </ItemGroup>
    <!-- The macro engine imports these by name from a Modules folder beside the app, so the tests
         need the same layout to exercise the real file rather than a copy of its contents. -->
    <ItemGroup>
        <None Include="..\ClassicAssist.Avalonia\Modules\**" Link="Modules\%(RecursiveDir)%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
