<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <!-- Matches the runtime TazUO ships; roll forward onto anything newer the user has. -->
    <RollForward>LatestMajor</RollForward>
    <!-- Microsoft.Testing.Platform, like ClassicAssist.HeadlessTests: the .NET 10 SDK dropped the
         VSTest-mode bridge for MTP, so both test projects run as MTP executables under the
         global.json test runner. MSTest's MTP entry point needs an executable. -->
    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="packetlengths.json" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="packetlengths.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ClassicAssist.Shared\ClassicAssist.Shared.csproj" />
    <ProjectReference Include="..\ClassicAssist.Launcher\ClassicAssist.Launcher.csproj" />
    <ProjectReference Include="..\ClassicAssist.Updater\ClassicAssist.Updater.csproj" />
  </ItemGroup>
    <!-- The macro engine imports these by name from a Modules folder beside the app, so the tests
         need the same layout to exercise the real file rather than a copy of its contents. -->
    <ItemGroup>
        <None Include="..\ClassicAssist.Avalonia\Modules\**" Link="Modules\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
