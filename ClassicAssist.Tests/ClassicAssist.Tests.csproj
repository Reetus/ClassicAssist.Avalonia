<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <!-- Matches the runtime TazUO ships; roll forward onto anything newer the user has. -->
    <RollForward>LatestMajor</RollForward>
    <!-- xUnit v3, like ClassicAssist.HeadlessTests: test projects have to be executables, and run on
         Microsoft.Testing.Platform under the global.json test runner (the .NET 10 SDK dropped the
         VSTest-mode bridge). -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="packetlengths.json" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="packetlengths.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <!-- Code coverage for the MTP runner: dotnet test with the coverage switch. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ClassicAssist.Shared\ClassicAssist.Shared.csproj" />
    <ProjectReference Include="..\ClassicAssist.Launcher\ClassicAssist.Launcher.csproj" />
    <ProjectReference Include="..\ClassicAssist.Updater\ClassicAssist.Updater.csproj" />
  </ItemGroup>
    <!-- The macro engine imports these by name from a Modules folder beside the app, so the tests
         need the same layout to exercise the real file rather than a copy of its contents. -->
    <ItemGroup>
        <None Include="..\ClassicAssist.Avalonia\Modules\**" Link="Modules\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
