<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!-- Embedded in the apphost binary. Separate from Window.Icon, which is what X11 reports as
             _NET_WM_ICON; this is the icon a file manager or a Windows shortcut shows. -->
        <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
        <!-- Deployed as a subfolder of the plugin; the plugin launches this apphost as a child process. -->
        <OutputPath>..\Output\ClassicAssist\ui\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
            <TargetFramework>net10.0</TargetFramework>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Matches the runtime TazUO ships; roll forward onto anything newer the user has. -->
    <RollForward>LatestMajor</RollForward>
    </PropertyGroup>
   <ItemGroup>
        <Folder Include="Models\" />
        <AvaloniaResource Include="Assets\**" />
        <!-- Python modules the macro engine puts on its search path; must be files on disk, not
             embedded resources, because IronPython imports them by name from that folder. -->
        <None Include="Modules\**" CopyToOutputDirectory="PreserveNewest" />
        <AvaloniaResource Include="Controls\GroupBox.Theme.xaml" />
        <AvaloniaResource Include="Controls\OptionsControls.Theme.xaml" />
        <AvaloniaResource Include="Controls\TabControl.Theme.xaml" />
        <AvaloniaResource Include="Controls\Compact.Theme.xaml" />
        <AvaloniaResource Include="Controls\ClassicAssistDark.xaml" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.3.8" />
        <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.3.0" />
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.8" />
        <PackageReference Include="Avalonia.Desktop" Version="11.3.8" />
        <!--
          Pinned ahead of Avalonia.FreeDesktop's transitive 0.21.2, which has a high-severity
          advisory (GHSA-xrw6-gwf8-vvr9 / CVE-2026-39959: D-Bus signal spoofing and fd
          exhaustion). 0.21.3 is the patch for that line - drop this once Avalonia ships it.
        -->
        <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
        <PackageReference Include="Avalonia.Skia" Version="11.3.8" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.8" />
        <PackageReference Include="MessagePack" Version="2.5.302" />
        <PackageReference Include="StreamJsonRpc" Version="2.22.23" />
        <PackageReference Include="System.Resources.Extensions" Version="9.0.0" />
        <PackageReference Include="System.Windows.Extensions" Version="10.0.10" />
        <PackageReference Include="Xaml.Behaviors.Interactions" Version="11.3.6.6" />
        <PackageReference Include="Xaml.Behaviors.Interactivity" Version="11.3.6.6" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\ClassicAssist.Plugin.Shared\ClassicAssist.Plugin.Shared.csproj" />
        <ProjectReference Include="..\ClassicAssist.Shared\ClassicAssist.Shared.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Reference Include="AvaloniaEdit">
            <HintPath>AvaloniaEdit.dll</HintPath>
        </Reference>
    </ItemGroup>
    <ItemGroup>
        <Compile Update="Views\AboutControl.axaml.cs">
            <DependentUpon>AboutControl.axaml</DependentUpon>
        </Compile>
        <Compile Update="Views\GeneralControl.axaml.cs">
            <DependentUpon>GeneralControl.axaml</DependentUpon>
        </Compile>
    </ItemGroup>
    <PropertyGroup>
        <BuildDate>$([System.DateTime]::op_Subtraction($([System.DateTime]::get_Now().get_Date()),$([System.DateTime]::new(2020,7,3))).get_TotalDays())</BuildDate>
        <Version>0.3.$(BuildDate).0</Version>
    </PropertyGroup>
</Project>
