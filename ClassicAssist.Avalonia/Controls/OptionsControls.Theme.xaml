<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ClassicAssist.Avalonia.Controls">

  <!-- Templates for the Options tab's building blocks, ported from the WPF ClassicAssist.Controls
       assembly (OptionedCheckBoxControl and Headered/HorizontalHeaderedContentControl). -->

  <Style Selector="controls|OptionedCheckBox">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal">
          <CheckBox IsChecked="{TemplateBinding IsChecked, Mode=TwoWay}"
                    Content="{TemplateBinding Content}"
                    Command="{TemplateBinding Command}"
                    CommandParameter="{TemplateBinding CommandParameter}"
                    VerticalAlignment="Center" />
          <!-- Disabled rather than hidden while unchecked, so the row doesn't reflow as it's toggled. -->
          <ContentPresenter Content="{TemplateBinding ChildContent}"
                            IsEnabled="{TemplateBinding IsChecked}"
                            VerticalAlignment="Center" Margin="5,0,0,0" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>

  <!--
    The label column is in a shared size group, so a container that sets Grid.IsSharedSizeScope lines
    its rows' boxes up behind the widest label - a stack of "Last target message:", "Friend target
    message:" ... otherwise starts each box wherever its own label happens to end. Without a scope
    the group does nothing and each row sizes its label alone, as before.
  -->
  <Style Selector=":is(controls|HorizontalHeaderedContentControl)">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="HorizontalHeader" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{TemplateBinding Header}"
                     Foreground="{TemplateBinding Foreground}"
                     VerticalAlignment="Center"
                     Margin="{TemplateBinding HeaderMargin}"
                     Width="{TemplateBinding HeaderWidth}"
                     MinWidth="{TemplateBinding HeaderMinWidth}" />
          <ContentPresenter Grid.Column="1" x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                            VerticalAlignment="Center" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

</Styles>
