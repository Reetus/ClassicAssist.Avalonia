<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="22"
             x:Name="Control"
             x:Class="ClassicAssist.Avalonia.Controls.FilterControl">
  <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Top">
    <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
          Fill="{DynamicResource ThemeForegroundBrush}"
          Data="M15.5,14h-0.79l-0.28,-0.27C15.41,12.59 16,11.11 16,9.5 16,5.91 13.09,3 9.5,3S3,5.91 3,9.5 5.91,16 9.5,16c1.61,0 3.09,-0.59 4.23,-1.57l0.27,0.28v0.79l5,4.99L20.49,19l-4.99,-5zM9.5,14C7.01,14 5,11.99 5,9.5S7.01,5 9.5,5 14,7.01 14,9.5 11.99,14 9.5,14z" />
    <TextBox x:Name="FilterTextBox" Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center"
             Text="{Binding FilterText, ElementName=Control, Mode=TwoWay}" />
    <Button Grid.Column="2" Margin="-15,0,0,0" Background="Transparent" BorderThickness="0" Padding="0"
            VerticalAlignment="Center" Command="{Binding CloseCommand, ElementName=Control}"
            IsVisible="{Binding ShowCloseButton, ElementName=Control}">
      <Path Width="8" Height="8" Stretch="Uniform" Fill="{DynamicResource ThemeForegroundBrush}"
            Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z" />
    </Button>
  </Grid>
</UserControl>
