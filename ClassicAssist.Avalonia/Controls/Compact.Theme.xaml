<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    FluentTheme is sized for touch - 32px minimum heights on inputs, ~34px list rows. These views were
    laid out against WPF's much denser defaults, so on Fluent everything gets a lot of dead vertical
    space and the panels no longer fit their windows. This pulls the common controls back to a
    desktop density; it only touches sizing, never colour, so the theme still supplies the palette.
  -->

  <Style Selector="ListBoxItem">
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="6,3"/>
  </Style>

  <Style Selector="ComboBoxItem">
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="8,4"/>
  </Style>

  <Style Selector="TreeViewItem">
    <Setter Property="MinHeight" Value="0"/>
  </Style>

  <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
    <Setter Property="MinHeight" Value="0"/>
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="8,4"/>
  </Style>

  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="6,3"/>
  </Style>

  <Style Selector="NumericUpDown">
    <Setter Property="MinHeight" Value="0"/>
  </Style>

  <!--
    Several views size buttons from equal-width grid columns inside a 200px panel, which leaves about
    68px per button - just enough for "Remove" at 13px with 6px of side padding, and not enough with
    Fluent's stock 11px.
  -->
  <Style Selector="Button">
    <Setter Property="Padding" Value="6,4"/>
  </Style>

  <!--
    Fluent gives CheckBox and RadioButton a 32px MinHeight and a 12px content gap. The list rows in
    General/Options are a checkbox plus a label, so that alone was setting the row height.
  -->
  <Style Selector="CheckBox">
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="8,0,0,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="RadioButton">
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="8,0,0,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="MenuItem">
    <Setter Property="MinHeight" Value="0"/>
  </Style>

  <Style Selector="DataGridRow">
    <Setter Property="MinHeight" Value="0"/>
  </Style>

  <Style Selector="DataGridColumnHeader">
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="8,4"/>
  </Style>
</Styles>
