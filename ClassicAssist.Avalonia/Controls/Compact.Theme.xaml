<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ClassicAssist.Avalonia.Controls">
  <!--
    FluentTheme is sized for touch - 32px minimum heights on inputs, ~34px list rows. These views were
    laid out against WPF's much denser defaults, so on Fluent everything gets a lot of dead vertical
    space and the panels no longer fit their windows. This pulls the common controls back to a
    desktop density; it only touches sizing, never colour, so the theme still supplies the palette.
  -->

  <Style Selector="ListBoxItem">
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="6,3"/>
  </Style>

  <Style Selector="ComboBoxItem">
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="8,4"/>
  </Style>

  <Style Selector="TreeViewItem">
    <Setter Property="MinHeight" Value="0"/>
  </Style>

  <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
    <Setter Property="MinHeight" Value="0"/>
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="8,4"/>
  </Style>

  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="6,3"/>
  </Style>

  <Style Selector="NumericUpDown">
    <Setter Property="MinHeight" Value="0"/>
  </Style>

  <Style Selector="NumericUpDown /template/ ButtonSpinner">
    <Setter Property="MinHeight" Value="0"/>
  </Style>

  <!--
    Several views size buttons from equal-width grid columns inside a 200px panel, which leaves about
    68px per button - just enough for "Remove" at 13px with 6px of side padding, and not enough with
    Fluent's stock 11px.
  -->
  <Style Selector="Button">
    <Setter Property="Padding" Value="6,4"/>
  </Style>

  <!--
    Fluent gives CheckBox and RadioButton a 32px MinHeight and a 12px content gap. The list rows in
    General/Options are a checkbox plus a label, so that alone was setting the row height.
  -->
  <Style Selector="CheckBox">
    <Setter Property="MinHeight" Value="20"/>
    <Setter Property="Padding" Value="8,0,0,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="RadioButton">
    <Setter Property="MinHeight" Value="20"/>
    <Setter Property="Padding" Value="8,0,0,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="MenuItem">
    <Setter Property="MinHeight" Value="0"/>
  </Style>

  <Style Selector="DataGridRow">
    <Setter Property="MinHeight" Value="0"/>
  </Style>

  <Style Selector="DataGridColumnHeader">
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="8,4"/>
  </Style>

  <!--
    The header template puts the sort arrow in its own column with a 32px MinWidth, reserved even
    while the column is unsorted and the arrow hidden. In a narrow column that left the header text
    a sliver ("Co" for Colour in a 64px column). Unsorted, let the text span that column too.
  -->
  <Style Selector="DataGridColumnHeader:not(:sortascending):not(:sortdescending) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Grid.ColumnSpan" Value="2"/>
  </Style>

  <!--
    Template-column cells get no padding of their own, unlike DataGridTextColumn's text (12px in), so
    an editable value sat on the column's left edge and its pencil icon ran into the next column's
    value. Inset to match the text columns, keep 8px clear of the next column, and centre in the row.
    A local Margin on a particular cell still wins.
  -->
  <Style Selector="DataGridCell controls|EditTextBlock">
    <Setter Property="Margin" Value="12,0,8,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="DataGridCell CheckBox">
    <Setter Property="Margin" Value="8,0,0,0"/>
  </Style>
</Styles>
