<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared"
        xmlns:filters="clr-namespace:ClassicAssist.Data.Filters;assembly=ClassicAssist.Shared"
        xmlns:misc="clr-namespace:ClassicAssist.Avalonia.Misc"
        xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="120"
        x:Class="ClassicAssist.Avalonia.Views.Filters.SeasonFilterConfigureWindow"
        Title="{x:Static resources:Strings.Seasons}" Width="400" SizeToContent="Height"
        Topmost="True">
  <!-- DataContext is supplied by the UI invoker (SeasonFilterConfigureViewModel). -->
  <Grid Margin="10" RowDefinitions="*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
      <TextBlock Grid.Column="0" Text="{x:Static resources:Strings.Selected_Season_}" VerticalAlignment="Center"/>
      <ComboBox Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Stretch"
                ItemsSource="{Binding Source={misc:EnumBindingSourceExtension {x:Type filters:Season}}}"
                SelectedItem="{Binding SelectedSeason}"/>
    </Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="{x:Static resources:Strings.Close}" IsDefault="True" Padding="20,4">
        <Interaction.Behaviors>
          <misc:CloseOnClickBehaviour/>
        </Interaction.Behaviors>
      </Button>
    </StackPanel>
  </Grid>
</Window>
