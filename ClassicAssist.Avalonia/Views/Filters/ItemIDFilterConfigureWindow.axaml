<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared"
        xmlns:filters="clr-namespace:ClassicAssist.Data.Filters;assembly=ClassicAssist.Shared"
        xmlns:controls="clr-namespace:ClassicAssist.Avalonia.Controls"
        xmlns:misc="clr-namespace:ClassicAssist.Avalonia.Misc"
        xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="350"
        x:Class="ClassicAssist.Avalonia.Views.Filters.ItemIDFilterConfigureWindow"
        Title="{x:Static resources:Strings.ItemID_Filter}" Width="480" Height="350"
        Topmost="True">
  <!-- DataContext is supplied by the UI invoker (ItemIDFilterConfigureViewModel). -->
  <Grid Margin="10" RowDefinitions="Auto,*,Auto">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="5">
      <Button Command="{Binding AddCommand}" ToolTip.Tip="{x:Static resources:Strings.Add}"
              Background="Transparent" Padding="4">
        <Image Source="{DynamicResource AddIcon}" Width="16" Height="16"/>
      </Button>
      <Button Command="{Binding RemoveCommand}" CommandParameter="{Binding SelectedItem}"
              ToolTip.Tip="{x:Static resources:Strings.Remove}" Background="Transparent" Padding="4">
        <Image Source="{DynamicResource RemoveIcon}" Width="16" Height="16"/>
      </Button>
    </StackPanel>
    <DataGrid Grid.Row="1" Margin="0,10" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
              AutoGenerateColumns="False" GridLinesVisibility="All" CanUserReorderColumns="False">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="✓" Width="35">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate DataType="filters:ItemIDFilterEntry">
              <CheckBox IsChecked="{Binding Enabled}" HorizontalAlignment="Center"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{x:Static resources:Strings.Source_ID}" Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate DataType="filters:ItemIDFilterEntry">
              <Grid ColumnDefinitions="*,Auto">
                <controls:EditTextBlock Grid.Column="0" Text="{Binding SourceID, Mode=TwoWay}" ShowIcon="True"
                                        VerticalAlignment="Center"/>
                <Button Grid.Column="1" Background="Transparent" Padding="2"
                        ToolTip.Tip="{x:Static resources:Strings.Choose_from_Item}"
                        Command="{Binding $parent[DataGrid].DataContext.TargetSourceIDCommand}"
                        CommandParameter="{Binding}">
                  <Image Source="{DynamicResource CrosshairIcon}" Width="12" Height="12"/>
                </Button>
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{x:Static resources:Strings.Destination_ID}" Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate DataType="filters:ItemIDFilterEntry">
              <Grid ColumnDefinitions="*,Auto">
                <controls:EditTextBlock Grid.Column="0" Text="{Binding DestinationID, Mode=TwoWay}" ShowIcon="True"
                                        VerticalAlignment="Center"/>
                <Button Grid.Column="1" Background="Transparent" Padding="2"
                        ToolTip.Tip="{x:Static resources:Strings.Choose_from_Item}"
                        Command="{Binding $parent[DataGrid].DataContext.TargetDestinationIDCommand}"
                        CommandParameter="{Binding}">
                  <Image Source="{DynamicResource CrosshairIcon}" Width="12" Height="12"/>
                </Button>
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{x:Static resources:Strings.Color}" Width="90">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate DataType="filters:ItemIDFilterEntry">
              <Grid ColumnDefinitions="*,Auto">
                <controls:EditTextBlock Grid.Column="0" Text="{Binding Hue, Mode=TwoWay}" ShowIcon="True"
                                        VerticalAlignment="Center"/>
                <Button Grid.Column="1" Background="Transparent" Padding="2"
                        Command="{Binding $parent[DataGrid].DataContext.SelectHueCommand}"
                        CommandParameter="{Binding}">
                  <Image Source="{DynamicResource ColorWheelIcon}" Width="12" Height="12"/>
                </Button>
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{x:Static resources:Strings.Close}" IsDefault="True" Padding="20,4">
        <Interaction.Behaviors>
          <misc:CloseOnClickBehaviour/>
        </Interaction.Behaviors>
      </Button>
    </StackPanel>
  </Grid>
</Window>
