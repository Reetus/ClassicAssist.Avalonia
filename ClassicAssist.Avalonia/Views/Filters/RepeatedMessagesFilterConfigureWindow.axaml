<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared"
        xmlns:controls="clr-namespace:ClassicAssist.Avalonia.Controls"
        xmlns:misc="clr-namespace:ClassicAssist.Avalonia.Misc"
        xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
        x:Class="ClassicAssist.Avalonia.Views.Filters.RepeatedMessagesFilterConfigureWindow"
        Title="{x:Static resources:Strings.Repeated_Messages}" Width="400" SizeToContent="Height"
        Topmost="True">
  <!-- DataContext is supplied by the UI invoker (RepeatedMessagesFilterConfigureViewModel). -->
  <Grid Margin="10" RowDefinitions="*,Auto">
    <controls:GroupBox Grid.Row="0" Header="{x:Static resources:Strings.Options}">
      <StackPanel Margin="10" Spacing="10">
        <CheckBox IsChecked="{Binding Options.SendToJournal}">
          <TextBlock Text="{x:Static resources:Strings.Journal_receives_filtered_messages}" TextWrapping="Wrap"/>
        </CheckBox>
        <Grid ColumnDefinitions="140,80,Auto">
          <TextBlock Grid.Column="0" Text="{x:Static resources:Strings.Message_Limit_}" VerticalAlignment="Center"/>
          <NumericUpDown Grid.Column="1" Minimum="0" Increment="1" FormatString="0"
                         Value="{Binding Options.MessageLimit}"/>
        </Grid>
        <Grid ColumnDefinitions="140,80,Auto">
          <TextBlock Grid.Column="0" Text="{x:Static resources:Strings.Time_Limit_}" VerticalAlignment="Center"/>
          <NumericUpDown Grid.Column="1" Minimum="0" Increment="1" FormatString="0"
                         Value="{Binding Options.TimeLimit}"/>
          <TextBlock Grid.Column="2" Text="{x:Static resources:Strings.seconds}" VerticalAlignment="Center"
                     Margin="5,0,0,0"/>
        </Grid>
        <Grid ColumnDefinitions="140,80,Auto">
          <TextBlock Grid.Column="0" Text="{x:Static resources:Strings.Filtered_Time_}" VerticalAlignment="Center"/>
          <NumericUpDown Grid.Column="1" Minimum="0" Increment="1" FormatString="0"
                         Value="{Binding Options.BlockedTime}"/>
          <TextBlock Grid.Column="2" Text="{x:Static resources:Strings.seconds}" VerticalAlignment="Center"
                     Margin="5,0,0,0"/>
        </Grid>
      </StackPanel>
    </controls:GroupBox>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="{x:Static resources:Strings.Close}" IsDefault="True" Padding="20,4">
        <Interaction.Behaviors>
          <misc:CloseOnClickBehaviour/>
        </Interaction.Behaviors>
      </Button>
    </StackPanel>
  </Grid>
</Window>
