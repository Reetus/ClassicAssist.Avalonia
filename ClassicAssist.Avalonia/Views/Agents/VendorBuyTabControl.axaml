<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared"
             xmlns:agents="clr-namespace:ClassicAssist.Shared.UI.ViewModels.Agents;assembly=ClassicAssist.Shared"
             xmlns:controls="clr-namespace:ClassicAssist.Avalonia.Controls"
             xmlns:misc="clr-namespace:ClassicAssist.Avalonia.Misc"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ClassicAssist.Avalonia.Views.Agents.VendorBuyTabControl">
  <UserControl.DataContext>
    <agents:VendorBuyTabViewModel/>
  </UserControl.DataContext>
  <UserControl.Resources>
    <misc:BooleanToStrikethroughValueConverter x:Key="BooleanToStrikethroughConverter" />
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="controls|EditTextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Inset like DataGridTextColumn's own text (12px), and keep each cell's pencil off the next
         column's value. -->
    <Style Selector="DataGridCell controls|EditTextBlock">
      <Setter Property="Margin" Value="12,0,8,0"/>
    </Style>
    <Style Selector="DataGridCell CheckBox">
      <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>
    <!-- The column widths below fit the English headers on one line. A longer translation is cut
         with an ellipsis, and the full header is in the tooltip. -->
    <Style Selector="DataGridColumnHeader">
      <Setter Property="ContentTemplate">
        <DataTemplate>
          <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}"/>
        </DataTemplate>
      </Setter>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="*, Auto">
    <Grid Grid.Row="0" ColumnDefinitions="150, *">
      <Grid RowDefinitions="*, Auto" Margin="0,0,10,0">
        <ListBox ItemsSource="{Binding Items}" Grid.Row="0" SelectedItem="{Binding SelectedItem}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <controls:EditTextBlock Text="{Binding Name}" ShowIcon="True"
                  TextDecorations="{Binding Enabled, Converter={StaticResource BooleanToStrikethroughConverter}}"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="1" Margin="0,10,0,0" ColumnDefinitions="*,*">
          <Button Content="{x:Static resources:Strings.Remove}" Grid.Column="0" Margin="0,0,5,0"
                  Command="{Binding RemoveCommand}" CommandParameter="{Binding SelectedItem}"/>
          <Button Content="{x:Static resources:Strings.New}" Grid.Column="1" Margin="5,0,0,0"
                  Command="{Binding InsertCommand}"/>
        </Grid>
      </Grid>
      <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto">
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
          <DockPanel.Styles>
            <Style Selector="CheckBox">
              <Setter Property="Margin" Value="0,0,20,0" />
            </Style>
          </DockPanel.Styles>
          <CheckBox Content="{x:Static resources:Strings.Enabled}" IsChecked="{Binding SelectedItem.Enabled}" />
          <CheckBox IsChecked="{Binding SelectedItem.IncludeBackpackAmount}"
                    Content="{x:Static resources:Strings.Include_Backpack_Amount}" />
        </DockPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedItem.Items}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="✓">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding Enabled}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="{x:Static resources:Strings.Graphic}" Width="72">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <controls:EditTextBlock Text="{Binding Graphic}"
                                          Label="{Binding Graphic, StringFormat={}0x{0:x}}" ShowIcon="True" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{x:Static resources:Strings.Name}" Binding="{Binding Name}" Width="*" MinWidth="100"/>
            <DataGridTemplateColumn Header="{x:Static resources:Strings.Color}" Width="64">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <controls:EditTextBlock Text="{Binding Hue}" ShowIcon="True" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="{x:Static resources:Strings.Amount}" Width="66">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <controls:EditTextBlock Text="{Binding Amount}" ShowIcon="True" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="{x:Static resources:Strings.Max_Price}" Width="76">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <controls:EditTextBlock Text="{Binding MaxPrice}" ShowIcon="True" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="{x:Static resources:Strings.Backpack_Graphic}" Width="116">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <controls:EditTextBlock Text="{Binding BackpackGraphic}"
                                          Label="{Binding BackpackGraphic, StringFormat={}0x{0:x}}" ShowIcon="True" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="{x:Static resources:Strings.Item_Weight}" Width="84">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <controls:EditTextBlock Text="{Binding Weight}" ShowIcon="True" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="{x:Static resources:Strings.Stackable}" Width="72">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding Stackable}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,10,0,0">
          <Button Content="{x:Static resources:Strings.Insert}" MinWidth="80"
                  Command="{Binding InsertEntryCommand}" CommandParameter="{Binding SelectedItem}" Margin="0,0,10,0"/>
          <Button Content="{x:Static resources:Strings.Remove}" MinWidth="80"
                  Command="{Binding RemoveEntryCommand}"
                  CommandParameter="{Binding SelectedEntry}"/>
        </StackPanel>
      </Grid>
    </Grid>
    <WrapPanel Orientation="Horizontal" Grid.Row="1" Margin="0,10,0,0">
      <WrapPanel.Styles>
        <Style Selector="CheckBox">
          <Setter Property="Margin" Value="0,5,20,5" />
        </Style>
        <Style Selector="StackPanel.setting > Label">
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.setting">
          <Setter Property="Orientation" Value="Horizontal" />
          <Setter Property="Margin" Value="0,5,20,5" />
        </Style>
      </WrapPanel.Styles>
      <CheckBox IsChecked="{Binding AutoDisableOnLogin}"
                Content="{x:Static resources:Strings.Auto_disable_when_loading}"
                ToolTip.Tip="{x:Static resources:Strings.Disable_all_vendor_buy_entries_on_loading_profile}" />
      <CheckBox IsChecked="{Binding CheckWeight}" Content="{x:Static resources:Strings.Check_Weight}" />
      <StackPanel Classes="setting">
        <Label Content="{x:Static resources:Strings.Minimum_Weight_Available_}" Margin="0,0,10,0" />
        <TextBox Width="70" Text="{Binding MinWeightAvailable}" IsEnabled="{Binding CheckWeight}" />
      </StackPanel>
      <CheckBox IsChecked="{Binding CheckItemCount}" Content="{x:Static resources:Strings.Check_Backpack_Item_Count}" />
      <StackPanel Classes="setting">
        <Label Content="{x:Static resources:Strings.Minimum_Items_Available_}" Margin="0,0,10,0" />
        <TextBox Width="70" Text="{Binding MinItemsAvailable}" IsEnabled="{Binding CheckItemCount}" />
      </StackPanel>
    </WrapPanel>
  </Grid>
</UserControl>
