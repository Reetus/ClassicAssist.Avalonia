<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
        xmlns:misc="clr-namespace:ClassicAssist.Avalonia.Misc"
        xmlns:controls="clr-namespace:ClassicAssist.Avalonia.Controls"
        xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
        x:Class="ClassicAssist.Avalonia.Views.Agents.Screenshot.ScreenshotMobileFilterWindow"
        Title="{x:Static resources:Strings.Screenshot}" Width="400" Height="450" Topmost="True">
  <Window.Resources>
    <misc:IntToHexStringValueConverter x:Key="IntToHexStringConverter"/>
  </Window.Resources>
  <Grid RowDefinitions="*, Auto" Margin="10">
    <DataGrid Grid.Row="0" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="✓">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding Enabled}" Margin="5,0"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{x:Static resources:Strings.ID}" Width="100">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <controls:EditTextBlock ShowIcon="True" VerticalContentAlignment="Center"
                                     Text="{Binding ID, Converter={StaticResource IntToHexStringConverter}, Mode=TwoWay}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{x:Static resources:Strings.Notes}" Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <controls:EditTextBlock ShowIcon="True" VerticalContentAlignment="Center"
                                     Text="{Binding Note, Mode=TwoWay}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="{x:Static resources:Strings.Add}" Command="{Binding AddCommand}" Padding="20,4"
              Margin="0,0,10,0"/>
      <Button Content="{x:Static resources:Strings.Remove}" Command="{Binding RemoveCommand}"
              CommandParameter="{Binding SelectedItem}" Padding="20,4" Margin="0,0,10,0"/>
      <Button Content="{x:Static resources:Strings.Target}" Command="{Binding TargetCommand}" Padding="20,4"
              Margin="0,0,10,0"/>
      <Button Content="{x:Static resources:Strings.OK}" IsDefault="True" Padding="20,4" Margin="0,0,10,0">
        <Interaction.Behaviors>
          <misc:CloseOnClickBehaviour Command="{Binding OkCommand}"/>
        </Interaction.Behaviors>
      </Button>
      <Button Content="{x:Static resources:Strings.Cancel}" Padding="20,4">
        <Interaction.Behaviors>
          <misc:CloseOnClickBehaviour/>
        </Interaction.Behaviors>
      </Button>
    </StackPanel>
  </Grid>
</Window>
