<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared"
             xmlns:agents="clr-namespace:ClassicAssist.Shared.UI.ViewModels.Agents;assembly=ClassicAssist.Shared"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="300"
             x:Class="ClassicAssist.Avalonia.Views.Agents.FriendsTabControl">
  <UserControl.DataContext>
    <agents:FriendsTabViewModel />
  </UserControl.DataContext>
  <Grid ColumnDefinitions="*,*" RowDefinitions="*, Auto">
    <ListBox Grid.Row="0" Grid.Column="0" ItemsSource="{Binding Options.Friends}" SelectedItem="{Binding SelectedItem}" />
    <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,*">
      <Button Content="{x:Static resources:Strings.Insert}" Grid.Column="0" Margin="0,5,5,5"
              Command="{Binding AddFriendCommand}" />
      <Button Content="{x:Static resources:Strings.Remove}" Grid.Column="1" Margin="5,5,0,5"
              Command="{Binding RemoveFriendCommand}" CommandParameter="{Binding SelectedItem}" />
    </Grid>
    <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0" Grid.RowSpan="2">
      <StackPanel.Styles>
        <Style Selector="CheckBox">
          <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
      </StackPanel.Styles>
      <CheckBox Content="{x:Static resources:Strings.Include_party_members}"
                IsChecked="{Binding Options.IncludePartyMembersInFriends}" />
      <CheckBox Content="{x:Static resources:Strings.Prevent_attacking_friends_in_war_mode}"
                IsChecked="{Binding Options.PreventAttackingFriendsInWarMode}" />
      <CheckBox Content="{x:Static resources:Strings.Prevent_targeting_friends_with_Harmful_spells}"
                IsChecked="{Binding Options.PreventTargetingFriendsWithHarmful}" />
      <StackPanel Orientation="Horizontal">
        <CheckBox Content="{x:Static resources:Strings.Rehue_friends}"
                  IsChecked="{Binding Options.CurrentOptions.RehueFriends}" Command="{Binding ChangeRehueOption}" />
        <Button Margin="10,0,0,0" Command="{Binding SelectHueCommand}">
          <ToolTip.Tip>
            <TextBlock>
              <Run Text="{x:Static resources:Strings.Hue}" /><Run Text=": " /><Run
                Text="{Binding Options.CurrentOptions.RehueFriendsHue, Mode=OneWay}" />
            </TextBlock>
          </ToolTip.Tip>
          <Image Source="{StaticResource ColorWheelIcon}" Height="12" Width="12" />
        </Button>
        <!-- The toggle and the popup share RehueLayersOpen, so light dismiss unchecks the toggle and
             opening rebuilds the list from the current profile. -->
        <ToggleButton x:Name="RehueLayersButton" Margin="5,0,0,0" ToolTip.Tip="{x:Static resources:Strings.Layers}"
                      IsEnabled="{Binding Options.CurrentOptions.RehueFriends}"
                      IsChecked="{Binding RehueLayersOpen}">
          <Image Source="{StaticResource FilterIcon}" Height="12" Width="12" />
        </ToggleButton>
        <Popup IsLightDismissEnabled="True" Placement="Bottom" PlacementTarget="{Binding #RehueLayersButton}"
               IsOpen="{Binding RehueLayersOpen}">
          <Border Background="{DynamicResource ThemeBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}"
                  BorderThickness="1" Padding="5">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,0,5">
                <Button Content="{x:Static resources:Strings.Select_All}" Padding="5,2"
                        Command="{Binding SelectAllLayersCommand}" />
                <Button Content="{x:Static resources:Strings.Deselect_All}" Padding="5,2"
                        Command="{Binding DeselectAllLayersCommand}" />
              </StackPanel>
              <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding RehueLayers}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}" Margin="0,1" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </Popup>
      </StackPanel>
    </StackPanel>

  </Grid>
</UserControl>
