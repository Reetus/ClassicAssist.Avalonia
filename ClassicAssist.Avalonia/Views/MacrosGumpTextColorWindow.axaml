<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared"
        mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="220"
        x:Class="ClassicAssist.Avalonia.Views.MacrosGumpTextColorWindow"
        Title="{x:Static resources:Strings.Text_Color}" Width="320" Height="220" Topmost="True">
  <Grid RowDefinitions="*, Auto, Auto" Margin="10">
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <WrapPanel x:Name="palette" VerticalAlignment="Top" />
    </ScrollViewer>
    <DockPanel Grid.Row="1" Margin="0,10,0,0">
      <TextBlock Text="{x:Static resources:Strings.Color}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox x:Name="hexTextBox" Text="{Binding SelectedColor, Mode=TwoWay}" VerticalAlignment="Center" />
    </DockPanel>
    <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="{x:Static resources:Strings.OK}" Command="{Binding OKCommand}" Padding="20,4" Margin="0,0,10,0" />
      <Button Content="{x:Static resources:Strings.Cancel}" Padding="20,4" />
    </StackPanel>
  </Grid>
</Window>
