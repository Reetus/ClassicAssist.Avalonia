<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ClassicAssist.UI.ViewModels;assembly=ClassicAssist.Shared"
             xmlns:resources="clr-namespace:ClassicAssist.Shared.Resources;assembly=ClassicAssist.Shared"
             xmlns:AvalonEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:misc="clr-namespace:ClassicAssist.Avalonia.Misc"
             xmlns:controls="clr-namespace:ClassicAssist.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Name="UserControl"
             x:Class="ClassicAssist.Avalonia.Views.MacrosTabControl">
  <UserControl.Resources>
    <misc:InverseBooleanValueConverter x:Key="InverseBooleanConverter" />
    <misc:MacroRunningToFontWeightConverter x:Key="MacroRunningToFontWeightConverter" />
    <misc:MacroRunningToFontStyleConverter x:Key="MacroRunningToFontStyleConverter" />
  </UserControl.Resources>
  <UserControl.DataContext>
    <viewModels:MacrosTabViewModel />
  </UserControl.DataContext>
  <UserControl.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding ExecuteCommand}" CommandParameter="{Binding SelectedItem}"/>
    <KeyBinding Gesture="Ctrl+F" Command="{Binding ToggleSearchCommand}" />
  </UserControl.KeyBindings>
  <Grid ColumnDefinitions="155,5,*">
    <Grid Grid.Column="0" RowDefinitions="Auto,*, Auto, Auto, Auto">
      <controls:FilterControl Grid.Row="0" Margin="0,0,0,5"
                              FilterText="{Binding FilterText}"
                              IsFilterVisible="{Binding IsFilterOpen}"
                              IsVisible="{Binding IsFilterOpen}" />
      <ListBox x:Name="ListBox" ItemsSource="{Binding FilterItems}" Grid.Row="1" SelectedItem="{Binding SelectedItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="*, Auto, Auto" Background="{Binding $parent.Background}">
              <controls:EditTextBlock Text="{Binding Name}" ShowIcon="False" Grid.Column="0" HorizontalContentAlignment="Stretch">
                <controls:EditTextBlock.FontWeight>
                  <MultiBinding Converter="{StaticResource MacroRunningToFontWeightConverter}">
                    <Binding Path="IsRunning" />
                    <Binding Path="IsBackground" />
                  </MultiBinding>
                </controls:EditTextBlock.FontWeight>
                <controls:EditTextBlock.FontStyle>
                  <MultiBinding Converter="{StaticResource MacroRunningToFontStyleConverter}">
                    <Binding Path="IsRunning" />
                    <Binding Path="IsBackground" />
                  </MultiBinding>
                </controls:EditTextBlock.FontStyle>
              </controls:EditTextBlock>
              <Image Grid.Column="1" Height="12" Margin="2,0,0,0" VerticalAlignment="Center"
                     Source="{StaticResource FileIcon}"
                     ToolTip.Tip="{Binding FilePath}"
                     IsVisible="{Binding IsFileBacked}" />
              <TextBlock x:Name="Hotkey" Text="{Binding Hotkey}" Margin="2,0,0,0"
                         Grid.Column="2" FontSize="7" Foreground="SpringGreen" TextAlignment="Right"
                         VerticalAlignment="Center" HorizontalAlignment="Right">
                <Interaction.Behaviors>
                  <DataTriggerBehavior Binding="{Binding #Hotkey.Text}" ComparisonCondition="Equal" Value="None">
                    <ChangePropertyAction TargetObject="{Binding #Hotkey}" PropertyName="IsVisible" Value="False"/>
                  </DataTriggerBehavior>
                  <DataTriggerBehavior Binding="{Binding #Hotkey.Text}" ComparisonCondition="NotEqual" Value="None">
                    <ChangePropertyAction TargetObject="{Binding #Hotkey}" PropertyName="IsVisible" Value="True"/>
                  </DataTriggerBehavior>
                </Interaction.Behaviors>
              </TextBlock>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Grid Grid.Row="2" ColumnDefinitions="*,*,*" Margin="0,5,0,0">
        <Grid.Styles>
          <!-- Three buttons across a 155px panel; matches the WPF build's local style for this row. -->
          <Style Selector="Button">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="4" />
          </Style>
        </Grid.Styles>
        <Button Content="{x:Static resources:Strings.Remove}" Grid.Column="0" Margin="0,0,2.5,0"
                Command="{Binding RemoveMacroConfirmCommand, Mode=OneWay}"
                CommandParameter="{Binding SelectedItem, ElementName=ListBox}" />
        <Button Content="{x:Static resources:Strings.New}" Grid.Column="1" Margin="2.5,0"
                Command="{Binding NewMacroCommand, Mode=OneWay}" />
        <Button Content="{x:Static resources:Strings.Save}" Grid.Column="2" Margin="2.5,0,0,0"
                Command="{Binding SaveMacroCommand, Mode=OneWay}" CommandParameter="{Binding SelectedItem}" />
      </Grid>
      <Grid Grid.Row="3" ColumnDefinitions="*,*" Margin="0,5,0,0">
        <Button Content="{x:Static resources:Strings.Play}" Grid.Column="0" Margin="0,0,2.5,0"
                Command="{Binding ExecuteCommand, Mode=OneWay}"
                CommandParameter="{Binding SelectedItem, ElementName=ListBox}" />
        <!--IsEnabled="{Binding SelectedItem.IsRunning, Converter={StaticResource InverseBooleanConverter}, ElementName=ListBox}" />-->
        <Button Content="{x:Static resources:Strings.Stop}" Grid.Column="1" Margin="2.5,0,0,0"
                Command="{Binding StopCommand, Mode=OneWay}" CommandParameter="{Binding SelectedItem}" />
        <!--IsEnabled="{Binding SelectedItem.IsRunning, ElementName=ListBox}"-->
      </Grid>
      <controls:GroupBox Header="{x:Static resources:Strings.Hotkeys}" DockPanel.Dock="Top" Grid.Row="4" Margin="0,5,0,0">
        <StackPanel>
          <controls:TextBoxKey Shortcut="{Binding DataContext.Hotkey, ElementName=UserControl}" />
          <CheckBox Content="{x:Static resources:Strings.Pass_to_UO}" Margin="0,5,0,0"
                    IsChecked="{Binding SelectedItem.PassToUO}" />
          <Button Content="{x:Static resources:Strings.Clear}" Padding="1,0,1,1" Margin="0,5,0,0"
                  Command="{Binding ClearHotkeyCommand, Mode=OneWay}"
                  CommandParameter="{Binding SelectedItem, ElementName=ListBox}" />
        </StackPanel>
      </controls:GroupBox>
    </Grid>
    <GridSplitter Grid.Column="1" Margin="5,0,5,0" />
    <Grid Grid.Column="2" RowDefinitions="*, Auto, Auto">
      <Border BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderMidBrush}" Padding="2" Grid.Row="0">
        <AvalonEdit:TextEditor x:Name="Editor" FontFamily="avares://ClassicAssist.Avalonia/Assets/Fonts/*.ttf#Ubuntu Mono"
                               Background="{DynamicResource ThemeInnerControlBackgroundBrush}">
          <Interaction.Behaviors>
            <misc:AvalonEditBehaviour Text="{Binding SelectedItem.Macro}" />
            <misc:AvalonEditCompletionBehaviour />
          </Interaction.Behaviors>
        </AvalonEdit:TextEditor>
      </Border>
      <WrapPanel Grid.Row="1">
        <WrapPanel.Styles>
          <Style Selector="CheckBox">
            <Setter Property="Margin" Value="0,5,10,0" />
          </Style>
        </WrapPanel.Styles>
        <CheckBox Content="{x:Static resources:Strings.Loop}"
                  IsChecked="{Binding SelectedItem.Loop, ElementName=ListBox}" />
        <CheckBox Content="{x:Static resources:Strings.Do_not_auto_interupt}"
                  IsChecked="{Binding SelectedItem.DoNotAutoInterrupt, ElementName=ListBox}" />
        <CheckBox Content="{x:Static resources:Strings.Run_in_background}"
                  IsChecked="{Binding SelectedItem.IsBackground, ElementName=ListBox}" />
        <CheckBox Content="{x:Static resources:Strings.Autostart}"
                  IsChecked="{Binding SelectedItem.IsAutostart, ElementName=ListBox}" />
        <CheckBox Content="{x:Static resources:Strings.Undisableable}"
                  IsChecked="{Binding SelectedItem.Disableable, Converter={StaticResource InverseBooleanConverter}}" />
        <CheckBox Content="{x:Static resources:Strings.Global}"
                  IsChecked="{Binding SelectedItem.Global}" />
      </WrapPanel>
      <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,5,0,0">
        <WrapPanel.Styles>
          <Style Selector="Button">
            <Setter Property="Margin" Value="0,0,5,5" />
          </Style>
        </WrapPanel.Styles>
        <Button Content="{x:Static resources:Strings.Object_Inspector}" Command="{Binding InspectObjectCommand}"/>
        <Button Content="{x:Static resources:Strings.Active_Objects}"
                Command="{Binding ShowActiveObjectsWindowCommand, Mode=OneWay}" />
        <Button Content="{x:Static resources:Strings.Create_Macro_Button}"
                Command="{Binding CreateMacroButtonCommand, Mode=OneWay}"
                CommandParameter="{Binding SelectedItem, ElementName=ListBox}" />
        <Button Content="{x:Static resources:Strings.Open_in_external_editor}"
                Command="{Binding OpenExternalCommand, Mode=OneWay}"
                CommandParameter="{Binding SelectedItem, ElementName=ListBox}" />
        <Button Content="{x:Static resources:Strings.Open_Macros_Folder}"
                Command="{Binding OpenMacrosFolderCommand, Mode=OneWay}" />
        <Button Content="{x:Static resources:Strings.Open_Modules_Folder}"
                Command="{Binding OpenModulesFolderCommand, Mode=OneWay}" />
        <Button Command="{Binding ShowMacrosWikiCommand, Mode=OneWay}" Padding="8,0"
                ToolTip.Tip="{x:Static resources:Strings.Macro_Commands_Wiki__Launches_in_Browser_}">
          <Image Source="{DynamicResource WebIcon}" Height="16" Width="16" />
        </Button>
      </WrapPanel>
    </Grid>
  </Grid>
</UserControl>