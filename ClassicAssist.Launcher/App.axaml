<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClassicAssist.Launcher.App" RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Assets/Icons.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme/>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    <StyleInclude Source="avares://ClassicAssist.Launcher/Controls/ClassicAssistDark.xaml"/>
    <StyleInclude Source="avares://ClassicAssist.Launcher/Controls/Compact.Theme.xaml"/>
    <StyleInclude Source="avares://ClassicAssist.Launcher/Controls/GroupBox.Theme.xaml"/>
    <StyleInclude Source="avares://ClassicAssist.Launcher/Controls/TabControl.Theme.xaml"/>
    <Style Selector="Button">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="DataGrid">
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMidBrush}"/>
    </Style>
    <!-- Belt-and-suspenders alongside the per-cell VerticalAlignment set on each CellTemplate root
         in ShardsWindow: rows are taller than a single line of text, and cell content otherwise
         renders top-aligned within that extra space. -->
    <Style Selector="DataGridCell">
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="WrapPanel.ToolBar Image">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
    </Style>
    <Style Selector="WrapPanel.ToolBar Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
  </Application.Styles>
</Application>
